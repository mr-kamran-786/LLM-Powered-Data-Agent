# Required: Google AI Studio key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Default model (any LiteLLM id). Fallbacks are used automatically on 503/429/404.
LLM_MODEL=gemini/gemini-3.1-flash-lite
# LLM_FALLBACK_MODELS=gemini/gemini-3.5-flash-lite,gemini/gemini-3-flash-preview,gemini/gemini-3.5-flash
# LLM_AVAILABLE_MODELS=gemini/gemini-3.1-flash-lite,gemini/gemini-3.5-flash,ollama/qwen2.5-coder:7b
# OLLAMA_BASE_URL=http://localhost:11434
# Requests per minute per model (Gemini free tier: 15). Raise on a paid tier; 0 = unlimited.
# LLM_REQUESTS_PER_MINUTE=14

# Agent behaviour
# MAX_AGENT_STEPS=10
# MAX_RETRIES=3
# CODE_TIMEOUT_SECONDS=60
# CRITIC_ENABLED=true
# SESSION_TOKEN_BUDGET=2000000

# Sandbox: "process" (default) or "docker" (requires: docker compose build sandbox-image)
# SANDBOX_BACKEND=process

# Optional tracing in Langfuse
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
